{
  "name": "muscle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:fast": "vitest run",
    "presubmit": "npm run typecheck && npm test && npm run muscle:validate-assets",
    "muscle:validate-assets": "node scripts/validate-muscle-assets.mjs",
    "muscle:export-glbs": "node scripts/export-muscle-procedural-glbs.mjs",
    "muscle:export-z-anatomy": "node scripts/export-muscle-z-anatomy-glbs.mjs",
    "muscle:sync-bridge": "node scripts/sync-muscle-z-anatomy-bridge.mjs",
    "muscle:sync-atlas-registry": "node scripts/sync-atlas-mesh-registry.mjs",
    "muscle:audit-export": "node scripts/audit-muscle-z-anatomy-export.mjs",
    "muscle:coverage": "MUSCLE_COVERAGE_REPORT=1 vitest run src/muscle/anatomy/anatomyCoverageLedger.test.ts",
    "muscle:inventory": "MUSCLE_RUNTIME_INVENTORY=1 vitest run src/muscle/anatomy/fullBodyRuntimeInventory.test.ts src/muscle/anatomy/anatomyCoverageLedger.test.ts",
    "muscle:export-pipeline": "node scripts/run-muscle-anatomy-export.mjs",
    "muscle:verify-links": "node scripts/verify-anatomy-links.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/noto-music": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dexie": "^4.4.7",
    "material-symbols": "^0.48.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.17",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
